{
  "name": "pi-connect",
  "version": "1.0.0",
  "private": true,
  "description": "Pi coding agent ports of the DeepSeek Harness plugins dsh-connect-qoder and dsh-connect-trae: bring your locally signed-in Qoder / Trae accounts into Pi as model providers, with usage and daily check-in commands.",
  "license": "MIT",
  "author": "citie114514",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/citie114514/pi-connect.git"
  },
  "type": "module",
  "workspaces": [
    "pi-connect-qoder",
    "pi-connect-trae"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "pack": "npm pack --workspaces --pack-destination dist",
    "pack:qoder": "npm pack -w @citie114514/pi-connect-qoder --pack-destination dist",
    "pack:trae": "npm pack -w @citie114514/pi-connect-trae --pack-destination dist",
    "publish:qoder": "npm publish -w @citie114514/pi-connect-qoder --access public",
    "publish:trae": "npm publish -w @citie114514/pi-connect-trae --access public"
  }
}
